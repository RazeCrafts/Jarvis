# JARVIS backend configuration — copy to .env and fill in.
# Everything here is editable later in the app's Settings tab.

# --- server ---
JARVIS_PORT=8420

# --- brain ---
# hermes | openrouter | auto  (auto = hermes, falls back to openrouter)
JARVIS_BRAIN=auto

# --- openrouter ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier model ids — verify current ids at https://openrouter.ai/models?max_price=0
JARVIS_DEFAULT_MODEL=deepseek/deepseek-chat-v3.1:free
JARVIS_FAST_MODEL=google/gemini-2.0-flash-exp:free
JARVIS_HEAVY_MODEL=deepseek/deepseek-r1:free

# --- safety ---
JARVIS_CONFIRM_DANGEROUS_TOOLS=true
JARVIS_CONFIRMATION_TIMEOUT_SECONDS=120
JARVIS_ALLOWED_APPS=notepad,calculator,explorer,spotify,chrome,edge,code

# --- voice ---
JARVIS_TTS_ENABLED=true
JARVIS_TTS_RATE=0.98
JARVIS_TTS_PITCH=0.85
